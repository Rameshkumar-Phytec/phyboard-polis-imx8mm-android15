From 2ab7a30a9513bbe7222674e33d35f6a30d8dda11 Mon Sep 17 00:00:00 2001
From: T S Rameshkumar <rameshkumar.t@phytecembedded.in>
Date: Fri, 23 Oct 2026 16:50:10 +0530
Subject: [PATCH 8/8] clk: imx8mm: Register UART3 as critical clock and add
 debug logging

On PHYTEC phyBOARD-Polis i.MX8MM, the serial console is UART3 (0x30880000).
Under Android 15 GKI, clock drivers are built as loadable modules. During
clk-imx8mm probe, registering non-critical composite clocks disables their
clock gate in hardware, killing UART3 and causing earlycon to hang.

Mark UART3 composite and UART3 root clock gate as CLK_IS_CRITICAL
(matching UART2) to keep console clocks active throughout boot. Add
explicit pr_info debug messages at probe entry, clock registration,
and completion for bring-up traceability.

Signed-off-by: T S Rameshkumar <rameshkumar.t@phytecembedded.in>
---
 drivers/clk/imx/clk-imx8mm.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/imx/clk-imx8mm.c b/drivers/clk/imx/clk-imx8mm.c
index 77940820b070..71d13ab8ccf8 100644
--- a/drivers/clk/imx/clk-imx8mm.c
+++ b/drivers/clk/imx/clk-imx8mm.c
@@ -328,6 +328,8 @@ static int imx8mm_clocks_probe(struct platform_device *pdev)
 	void __iomem *base;
 	int ret;
 
+	pr_info("clk-imx8mm: starting i.MX8MM clock driver probe\n");
+
 	check_m4_enabled();
 
 	clk_hw_data = kzalloc(struct_size(clk_hw_data, hws,
@@ -517,8 +519,9 @@ static int imx8mm_clocks_probe(struct platform_device *pdev)
 	hws[IMX8MM_CLK_I2C4] = imx8m_clk_hw_composite("i2c4", imx8mm_i2c4_sels, base + 0xae80);
 	hws[IMX8MM_CLK_UART1] = imx8m_clk_hw_composite("uart1", imx8mm_uart1_sels, base + 0xaf00);
 	hws[IMX8MM_CLK_UART2] = imx8m_clk_hw_composite_critical("uart2", imx8mm_uart2_sels, base + 0xaf80);
-	hws[IMX8MM_CLK_UART3] = imx8m_clk_hw_composite("uart3", imx8mm_uart3_sels, base + 0xb000);
+	hws[IMX8MM_CLK_UART3] = imx8m_clk_hw_composite_critical("uart3", imx8mm_uart3_sels, base + 0xb000);
 	hws[IMX8MM_CLK_UART4] = imx8m_clk_hw_composite("uart4", imx8mm_uart4_sels, base + 0xb080);
+	pr_info("clk-imx8mm: registered UART2 and UART3 as critical composite clocks\n");
 	hws[IMX8MM_CLK_USB_CORE_REF] = imx8m_clk_hw_composite("usb_core_ref", imx8mm_usb_core_sels, base + 0xb100);
 	hws[IMX8MM_CLK_USB_PHY_REF] = imx8m_clk_hw_composite("usb_phy_ref", imx8mm_usb_phy_sels, base + 0xb180);
 	hws[IMX8MM_CLK_GIC] = imx8m_clk_hw_composite_critical("gic", imx8mm_gic_sels, base + 0xb200);
@@ -587,8 +590,9 @@ static int imx8mm_clocks_probe(struct platform_device *pdev)
 	hws[IMX8MM_CLK_SAI6_IPG] = imx_clk_hw_gate2_shared2("sai6_ipg_clk", "ipg_audio_root", base + 0x4380, 0, &share_count_sai6);
 	hws[IMX8MM_CLK_UART1_ROOT] = imx_clk_hw_gate4("uart1_root_clk", "uart1", base + 0x4490, 0);
 	hws[IMX8MM_CLK_UART2_ROOT] = imx_clk_hw_gate4("uart2_root_clk", "uart2", base + 0x44a0, 0);
-	hws[IMX8MM_CLK_UART3_ROOT] = imx_clk_hw_gate4("uart3_root_clk", "uart3", base + 0x44b0, 0);
+	hws[IMX8MM_CLK_UART3_ROOT] = imx_clk_hw_gate4_flags("uart3_root_clk", "uart3", base + 0x44b0, 0, CLK_IS_CRITICAL);
 	hws[IMX8MM_CLK_UART4_ROOT] = imx_clk_hw_gate4("uart4_root_clk", "uart4", base + 0x44c0, 0);
+	pr_info("clk-imx8mm: registered UART3 root clock as critical gate\n");
 	hws[IMX8MM_CLK_USB1_CTRL_ROOT] = imx_clk_hw_gate4("usb1_ctrl_root_clk", "usb_bus", base + 0x44d0, 0);
 	hws[IMX8MM_CLK_GPU3D_ROOT] = imx_clk_hw_gate4("gpu3d_root_clk", "gpu3d_core", base + 0x44f0, 0);
 	hws[IMX8MM_CLK_USDHC1_ROOT] = imx_clk_hw_gate4("usdhc1_root_clk", "usdhc1", base + 0x4510, 0);
@@ -640,6 +644,8 @@ static int imx8mm_clocks_probe(struct platform_device *pdev)
 
 	imx_register_uart_clocks();
 
+	pr_info("clk-imx8mm: clock provider successfully registered (%d clocks registered)\n", IMX8MM_CLK_END);
+
 	return 0;
 
 unregister_hws:
