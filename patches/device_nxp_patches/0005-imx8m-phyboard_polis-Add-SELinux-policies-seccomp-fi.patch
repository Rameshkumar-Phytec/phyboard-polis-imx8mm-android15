 imx8m/phyboard_polis/required_hardware.xml    | 36 +++++++++++++
 .../seccomp/mediacodec-seccomp.policy         |  1 +
 .../seccomp/mediaextractor-seccomp.policy     |  5 ++
 imx8m/phyboard_polis/sepolicy/file_contexts   | 32 ++++++++++++
 imx8m/phyboard_polis/sepolicy/genfs_contexts  | 18 +++++++
 9 files changed, 202 insertions(+)
