 configs/phycore-imx8mm_android_uuu_defconfig  | 203 +++++++++++++++++
 .../fastboot/fb_fsl/fastboot_lock_unlock.c    |   5 +
 include/configs/phycore_imx8mm.h              |   4 +
 include/configs/phycore_imx8mm_android.h      |  56 +++++
 5 files changed, 478 insertions(+)
 create mode 100644 configs/phycore-imx8mm_android_defconfig
 create mode 100644 configs/phycore-imx8mm_android_uuu_defconfig
 create mode 100644 include/configs/phycore_imx8mm_android.h

